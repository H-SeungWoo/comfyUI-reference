{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-shot-builder.local/schemas/shot_spec.schema.json",
  "title": "AI Shot Builder ShotSpec",
  "description": "Structured shot definition for reusable image and video generation workflows.",
  "type": "object",
  "required": [
    "shot_id",
    "character",
    "environment",
    "composition",
    "lighting",
    "mood",
    "motion"
  ],
  "properties": {
    "shot_id": {
      "type": "string",
      "minLength": 1
    },

    "character": {
      "type": "object",
      "required": [
        "subject",
        "action",
        "facing"
      ],
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "facing": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },

    "environment": {
      "type": "object",
      "required": [
        "location",
        "time"
      ],
      "properties": {
        "location": {
          "type": "string",
          "minLength": 1
        },
        "time": {
          "type": "string",
          "minLength": 1
        },
        "weather": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },

    "composition": {
      "type": "object",
      "required": [
        "shot_size",
        "camera_view",
        "subject_position",
        "perspective"
      ],
      "properties": {
        "shot_size": {
          "type": "string",
          "minLength": 1
        },
        "camera_view": {
          "type": "string",
          "minLength": 1
        },
        "subject_position": {
          "type": "string",
          "minLength": 1
        },
        "perspective": {
          "type": "string",
          "minLength": 1
        },
        "vanishing_point": {
          "type": "string"
        },
        "leading_lines": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },

    "lighting": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },

    "mood": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },

    "motion": {
      "type": "object",
      "required": [
        "subject_motion",
        "camera_motion",
        "speed",
        "scene_stability",
        "composition_preservation"
      ],
      "properties": {
        "subject_motion": {
          "type": "string",
          "minLength": 1
        },
        "camera_motion": {
          "type": "string",
          "minLength": 1
        },
        "speed": {
          "type": "string",
          "enum": [
            "very_slow",
            "slow",
            "moderate",
            "fast"
          ]
        },
        "scene_stability": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "composition_preservation": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}